{
  "name": "agentlens",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @norberia/agentlens",
    "build:web": "npm run build -w @norberia/agentlens-web",
    "dev": "npm run dev -w @norberia/agentlens-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @norberia/agentlens-core && npm run test -w @norberia/agentlens"
  },
  "engines": {
    "node": ">=18"
  }
}
